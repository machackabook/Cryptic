{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cryptic-sos-mesh",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cryptic-sos-mesh",
      "database_id": "8f945ddf-dcc4-4f16-a28b-6b5db39ba685"
    }
  ],
  "vars": {
    "GOOGLE_ISSUER": "https://accounts.google.com",
    "GOOGLE_AUDIENCE": "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID",
    "PORTAL_ISSUER": "https://crypticnews.cloudflareaccess.com",
    "PORTAL_AUDIENCE": "fac224bcc6b364514390deb38330bd171935ea0afd09d87c31985a7c553bd828",
    "PORTAL_JWKS_URL": "https://crypticnews.cloudflareaccess.com/cdn-cgi/access/certs",
    "PORTAL_IDP_TYPE": "cloudflare-access",
    "ALLOWED_ORIGINS": "https://aistudio.google.com,https://crypticnews.org,https://www.crypticnews.org",
    "AGENT_ID": "nexus-local-01"
  }
}
