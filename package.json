{
  "name": "cryptic",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "npm run check:syntax && npm run check:csp && npm run lint",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:static": "node tests/static-server.test.mjs",
    "lint": "node scripts/verify.mjs",
    "test:security": "node tests/security.test.mjs",
    "test:audit": "node tests/pages-audit.test.mjs",
    "test:network": "node tests/network-security.test.mjs",
    "test:diff": "node tests/security-diff.test.mjs",
    "audit:network": "node scripts/network-security.mjs",
    "start:security": "node runtime/security-service.mjs",
    "test:service": "node tests/security-service.test.mjs",
    "test:console": "node tests/security-console.test.mjs",
    "test:vpn": "node tests/vpn-plan.test.mjs",
    "check:csp": "node scripts/check-csp.mjs"
  }
}
